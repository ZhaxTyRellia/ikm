{
    "name": "mtproject/ikm-survey",
    "description": "Satisfaction Survey System (IKM) - Slim Framework v4",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "php-di/php-di": "^7.1",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}

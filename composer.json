{
    "name": "mtproject/ikm-survey",
    "description": "Satisfaction Survey System (IKM) - Slim Framework v4",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/php-view": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
